############################################################
#
# SI - Ge/AU PLASMONIC STRUCTURE
#
# FDTD - Ansys Lumerical 2025 R1.3
#
# PARAMETRIZED STRUCTURE
#
# X = propagation direction
# Y = lateral direction
# Z = vertical direction
#
# STRUCTURE:

############################################################
# CLEAN START
############################################################

clear;
switchtolayout;
deleteall;

############################################################
# WAVELENGTH
############################################################

lambda0 = 1.55e-6;


############################################################
# ==========================================================
# MAIN PARAMETER
# ==========================================================
############################################################

Si_W_in = 440e-9;
Si_W_min = 90e-9;
Ge_L = 8.0e-6;
Si_H = 220e-9;


Au_W = 0.8e-6;
L_ant_Au = Au_W;

Ag_W = 0.250e-6;
L_ant_Ag = Ag_W;


# GOLD / SILVER
# ==========================================================
############################################################

Au_H = Si_H;

Au_W_fix =  1.0e-6;
# SiO2
# ==========================================================
############################################################

SiO2_bottom_H = 2e-6;
SiO2_side = 1.5e-6; 
SiO2_top_H = 1e-6;

# GE
# ==========================================================
############################################################

Ge_W = Si_W_min;
Ge_H = Si_H;

############################################################
# ==========================================================
# MATERIALS
# ==========================================================
############################################################

Si_mat = "Si (Silicon) - Palik";
SiO2_mat = "SiO2 (Glass) - Palik";
Ge_mat = "Ge (Germanium) - Palik";
Au_mat = "Au (Gold) - Palik";
Ag_mat = "Ag (Silver) - CRC";
TiO2_mat = "TiO2 (Titanium Dioxide) - Devore";
Air = "etch";


############################################################
# ==========================================================
# LONGITUDES EN X
# ==========================================================
############################################################

L_input = 12.0e-6;
L_taper = 2.0e-6;
L_Ge = Ge_L;
#L_output = 0.0e-6;

# TOTAL LENGTH
# ==========================================================
############################################################

L_total = L_input + L_taper + L_Ge + L_taper;

# POSICIONES X
# ==========================================================
############################################################

x0 = -L_total/2;
x1 = x0 + L_input;
x2 = x1 + L_taper;
x3 = x2 + L_Ge;
x4 = x3 + L_taper;
#x5 = x4 + L_output;

x_ant = x2 + 6e-6;
x_ant_var_Ag =  x_ant - L_ant_Ag;
x_ant_var_Au =  x_ant - L_ant_Au;

# POSICIONES Z
# ==========================================================
############################################################

Si_zmin = 0;
Si_zmax = Si_H;
Ge_zmin = Si_zmin;
Ge_zmax = Si_zmax;
Au_zmin = Si_zmin;
Au_zmax = Si_zmax;

############################################################
# ==========================================================
# SILICON
# ==========================================================
############################################################

# SILICON INPUT
# ==========================================================
############################################################

addrect;
set("material",Si_mat);
set("name","Si_Input");
##set("mesh order",1);
set("x min",x0);
set("x max",x1);
set("y min",-Si_W_in/2);
set("y max",Si_W_in/2);
set("z min",Si_zmin);
set("z max",Si_zmax);

# SILICON TAPER 
# ==========================================================
############################################################

addpoly;

set("name","Si_Taper_Left");
set("material",Si_mat);
set("z min",Si_zmin);
set("z max",Si_zmax);
V = matrix(4,2);
V(1,1) = x1;
V(1,2) = -Si_W_in/2;
V(2,1) = x1;
V(2,2) = Si_W_in/2;
V(3,1) = x2;
V(3,2) = Si_W_min/2;
V(4,1) = x2;
V(4,2) = -Si_W_min/2;
set("vertices",V);

############################################################
# ==========================================================
# GE
# ==========================================================
############################################################

addrect;

set("name","Ge");
set("material",Ge_mat);
set("x min",x2);
set("x max",x3);
set("y min",-Ge_W/2);
set("y max",Ge_W/2);
set("z min",Ge_zmin);
set("z max",Ge_zmax);

############################################################
# ==========================================================
#Silver LOWER PATH
# ==========================================================
############################################################
x_ant = x2 + 6e-6;
x_ant_var_Ag =  x_ant - L_ant_Ag;
x_ant_var_Au =  x_ant - L_ant_Au;


addpoly;

set("name","Ag_Lower_Path");
set("material",Ag_mat);
set("z min",Au_zmin);
set("z max",Au_zmax);

V = matrix(8,2);
# taper original
V(1,1)=x1;
V(1,2)=-Si_W_in/2;
V(2,1)=x2;
V(2,2)=-Ge_W/2;
# apertura antena
V(3,1)=x_ant; 
V(3,2)=-Ge_W/2;
V(4,1)=x_ant;  
V(4,2)=-Ge_W/2-Ag_W;
# punta antena
V(5,1)=x_ant_var_Ag;
V(5,2)=-Ge_W/2-Ag_W;
# retorno
V(6,1)=x2;
V(6,2)=-Si_W_in/2-Au_W_fix;
V(7,1)=x1;
V(7,2)=-Si_W_in/2-Au_W_fix;
V(8,1)=x1;
V(8,2)=-Si_W_in/2;
set("vertices",V);


############################################################
# ==========================================================
# GOLD UPPER PATH
# ==========================================================
############################################################

addpoly;

set("name","Au_Upper_Path");
set("material",Au_mat);
set("z min",Au_zmin);
set("z max",Au_zmax);
V = matrix(10,2);
V(1,1)=x1;
V(1,2)=Si_W_in/2;
V(2,1)=x2;
V(2,2)=Ge_W/2;
V(3,1)=x_ant;
V(3,2)=Ge_W/2;
V(4,1)=x_ant;
V(4,2)=Ge_W/2+Au_W;
V(5,1)=x_ant_var_Au;
V(5,2)=Ge_W/2 + Au_W;
V(6,1)=x2;
V(6,2)=Si_W_in/2+Au_W_fix;
V(7,1)=x1;
V(7,2)=Si_W_in/2+Au_W_fix;
V(8,1)=x1;
V(8,2)=Si_W_in/2;

set("vertices",V);


############################################################
# ==========================================================
# SiO2 
# ==========================================================
############################################################

# SiO2 Bottom
# ==========================================================
addrect;

set("name","SiO2_bottom");
set("material",SiO2_mat);
set("x min",x0);
set("x max",x3);
set("y min",-SiO2_side);
set("y max",SiO2_side);
set("z min",-SiO2_bottom_H);
set("z max",0);

# SiO2 Top
# ==========================================================
addrect;
set("name","SiO2_top");
set("material",SiO2_mat);
set("x min",x0);
set("x max",x1);
set("y min",-SiO2_side);
set("y max",SiO2_side);
set("z min",0);
set("z max",Si_H + SiO2_top_H);
set("Alpha",0.2);

addrect;
set("name","SiO2_top");
set("material",SiO2_mat);
set("x min",x1);
set("x max",x2);
set("y min",-SiO2_side);
set("y max",SiO2_side);
set("z min",Ge_H);
set("z max",Si_H + SiO2_top_H);
set("Alpha",0.2);


############################################################
# ==========================================================
# FDTD REGION
# ==========================================================
############################################################

addfdtd;
set("x min",x0-0.5e-6);
set("x max",x3+0.5e-6);
set("y min",-1.5e-6);
set("y max",1.5e-6);
set("z min",-0.8e-6);
set("z max",0.8e-6);
set("background material",Air);

############################################################
# ==========================================================
# LOCAL MESH
# ==========================================================
############################################################

addmesh;
set("name","Mesh_Plasmonic");
set("x min",x1-0.2e-6);
set("x max",x3);
set("y min",-Ge_W/2-Au_W-0.2e-6);
set("y max",Ge_W/2+Au_W+0.2e-6);
set("z min",Ge_zmin-0.1e-6);
set("z max",Ge_zmax+0.1e-6);
set("dx",10e-9);
set("dy",10e-9);
set("dz",10e-9);


############################################################
# ==========================================================
# MODE SOURCE
# ==========================================================
############################################################

addmode;
set("name","Mode_Source");
set("injection axis","x-axis");
set("direction","forward");
source_x = x0+0.5e-6;
set("x",source_x);
set("y",0);
set("z",Si_H/2);
set("y span",1.5e-6);
set("z span",1.0e-6);
set("wavelength start",lambda0);
set("wavelength stop",lambda0);
set("selected mode number",6);

############################################################
# ==========================================================
# FIELD MONITOR INPUT
# ==========================================================
############################################################

adddftmonitor;
set("name","Mode_Check_Input");
set("monitor type","2D X-normal");
set("x",x0/2);
set("y",0);
set("y span",1.5e-6);
set("z",Si_H/2);
set("z span",1.0e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

############################################################
# ==========================================================
# FIELD MONITOR CENTER
# ==========================================================
############################################################

#adddftmonitor;
#set("name","Field_Ge_Au_Center");
#set("monitor type","2D X-normal");
#set("x",x1+1e-6);
#set("y",0);
#set("y span",1.0e-6);
#set("z",0.125e-6);
#set("z span",0.5e-6);
#set("override global monitor settings",1);
#set("use wavelength spacing",1);
#set("frequency points",1);

adddftmonitor;
set("name","Field_Ge_end");
set("monitor type","2D X-normal");
set("x",x3);
set("y",0);
set("y span",Ge_W);
set("z",Ge_H/2);
set("z span",Ge_H);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

adddftmonitor;
set("name","Field_Ge_Start");
set("monitor type","2D X-normal");
set("x",x2);
set("y",0);
set("y span",Ge_W);
set("z",Ge_H/2);
set("z span",Ge_H);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

adddftmonitor;
set("name","Field_Ge_Ant");
set("monitor type","2D X-normal");
set("x",x_ant);
set("y",0);
set("y span",Ge_W);
set("z",Ge_H/2);
set("z span",Ge_H);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

############################################################
# ==========================================================
# MODE EXPANSION INPUT
# ==========================================================
############################################################

adddftmonitor;
set("name","ME_Input_Field");
set("monitor type","2D X-normal");
set("x",x0+1.5e-6);
set("y",0);
set("y span",1.5e-6);
set("z",Si_H/2);
set("z span",1.0e-6);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("frequency points",1);

############################################################
# MONITOR LINEAL
############################################################
adddftmonitor;
set("name","T");
set("monitor type","Linear Y");
set("x", x2) ;
set("y", 0);
set("y span", Ge_W);
set("z",Ge_zmax/2);

############################################################
# MONITOR LINEAL
############################################################
adddftmonitor;
set("name","R");
set("monitor type","Linear Y");
set("x", x3) ;
set("y", 0);
set("y span", Ge_W);
set("z",Ge_zmax/2);

##############################################################
### REGION DE GENERACION
##############################################################
##addobject("CW_generation");
##posi =  x2 + ( (x3 - x2) / 2);
##set("name","CW_Generation_Ge_Au");
##set("x", posi) ;
##set("x span", L_Ge);
##set("y", 0);
##set("y span", Ge_W + 0.5e-6);
##set("z",Ge_zmax/2);
##set("z span", Ge_H);
##set("source intensity",1);
##set("average dimension","none");


############################################################
# REGION DE GENERACION
############################################################
adddftmonitor;
set("name","Ge_Abs");
set("monitor type","3D");
set("x min",x2);
set("x max",x3);
set("y min",-Ge_W/2);
set("y max", Ge_W/2);
set("z min",Ge_zmin);
set("z max",Ge_zmax);
set("override global monitor settings",1);
set("frequency points",1);

############################################################
############################################################
############################################################

###########################################################
 ##PARAMETRIC SWEEP: Au_W vs Ag_W
 ##Ansys Lumerical FDTD 2025 R1.3
 ##25 simulations: 5 Au widths x 5 Ag widths
###########################################################

#Widths in nanometers converted to meters
W_values = [150,175,200,225,250]*1e-9;
N = length(W_values);

# Results: rows = Au_W, columns = Ag_W
#E2max_Start   = matrix(N,N);
E2max_Ant     = matrix(N,N);
E2max_T2     = matrix(N,N);
E2max_GeAbs   = matrix(N,N);

 #Store the geometry values for each result
Au_values = W_values;
Ag_values = W_values;

for (i=1:N) {
    for (j=1:N) {

         #Return to layout mode before modifying geometry
        switchtolayout;


        Au_W = W_values(i);
        Ag_W = W_values(j);

        ?("==========================================");
        ?("Simulation: Au_W = "+num2str(Au_W*1e9)+" nm");
        ?("            Ag_W = "+num2str(Ag_W*1e9)+" nm");
        
        ############################################################
        # UPDATE METAL PATHS: Au_W AND Ag_W SWEEP
        ############################################################
        
        # ----------------------------------------------------------
        # 1. SILVER LOWER PATH
        # ----------------------------------------------------------
        
        x_ant = x2 + 6e-6;
        x_ant_var_Ag = x_ant - L_ant_Ag;
      
        V_Ag = matrix(8,2);
        
        # Taper original
        V_Ag(1,1) = x1;
        V_Ag(1,2) = -Si_W_in/2;
        
        V_Ag(2,1) = x2;
        V_Ag(2,2) = -Ge_W/2;
        
        # Apertura de antena
        V_Ag(3,1) = x_ant;
        V_Ag(3,2) = -Ge_W/2;
        
        V_Ag(4,1) = x_ant;
        V_Ag(4,2) = -Ge_W/2-Ag_W;
        
        # Punta de antena
        V_Ag(5,1) = x_ant_var_Ag;
        V_Ag(5,2) = -Ge_W/2-Ag_W;
        
        # Retorno
        V_Ag(6,1) = x2;
        V_Ag(6,2) = -Si_W_in/2-Au_W_fix;
        
        V_Ag(7,1) = x1;
        V_Ag(7,2) = -Si_W_in/2-Au_W_fix;
        
        V_Ag(8,1) = x1;
        V_Ag(8,2) = -Si_W_in/2;
        
        # Actualizar el poligono existente
        setnamed("Ag_Lower_Path","vertices",V_Ag);
        
        
        # ----------------------------------------------------------
        # 2. GOLD UPPER PATH
        # ----------------------------------------------------------
        
        x_ant_var_Au = x_ant - L_ant_Au;
        
        V_Au = matrix(8,2);
        
        # Taper original
        V_Au(1,1) = x1;
        V_Au(1,2) = Si_W_in/2;
        
        V_Au(2,1) = x2;
        V_Au(2,2) = Ge_W/2;
        
        # Apertura de antena
        V_Au(3,1) = x_ant;
        V_Au(3,2) = Ge_W/2;
        
        V_Au(4,1) = x_ant;
        V_Au(4,2) = Ge_W/2+Au_W;
        
        # Punta de antena
        V_Au(5,1) = x_ant_var_Au;
        V_Au(5,2) = Ge_W/2+Au_W;
        
        # Retorno
        V_Au(6,1) = x2;
        V_Au(6,2) = Si_W_in/2+Au_W_fix;
        
        V_Au(7,1) = x1;
        V_Au(7,2) = Si_W_in/2+Au_W_fix;
        
        V_Au(8,1) = x1;
        V_Au(8,2) = Si_W_in/2;
        
        # Actualizar el poligono existente
        setnamed("Au_Upper_Path","vertices",V_Au);
        
        ###################################################
        ## RUN FDTD
        ###################################################

        run;
          
        ###################################################
        ## MONITOR Ant: MAXIMUM |E|^2
        ###################################################

        EAnt_data = getresult("Field_Ge_Ant","E");

        EAnt2 = abs(EAnt_data.Ex)^2
             + abs(EAnt_data.Ey)^2
             + abs(EAnt_data.Ez)^2;

        E2max_Ant(i,j) = max(EAnt2);

        ###################################################
        ## MONITOR End: MAXIMUM |E|^2
        ###################################################

        Et2_data = getresult("Field_Ge_end","E");

        Et22 = abs(Et2_data.Ex)^2
             + abs(Et2_data.Ey)^2
             + abs(Et2_data.Ez)^2;

        E2max_T2(i,j) = max(Et22);

        ###################################################
        ## Ge_Abs: MAXIMUM |E|^2 IN THE Ge VOLUME
        ###################################################

        Eg = getresult("Ge_Abs","E");

        Eg2 = abs(Eg.Ex)^2
            + abs(Eg.Ey)^2
            + abs(Eg.Ez)^2;

        E2max_GeAbs(i,j) = max(Eg2);
        
###########################################################
 #FIELD_Ge_Inicio: |E|^2 EN EL PLANO Y-Z
 #X fijo, 19 puntos en Y y 28 puntos en Z
###########################################################

FieldData = getresult("Field_Ge_Ant","E");

# Extraer componentes del campo electrico
Ex = pinch(FieldData.Ex,4,1);
Ey = pinch(FieldData.Ey,4,1);
Ez = pinch(FieldData.Ez,4,1);

 #Calcular intensidad |E|^2
E2 = abs(Ex)^2 + abs(Ey)^2 + abs(Ez)^2;

 #Coordenadas del monitor en micrometros
y_field = FieldData.y*1e6;
z_field = FieldData.z*1e6;

 #Eliminar la dimension X (X tiene longitud 1)
E2_yz = pinch(E2,1,1);

# Verificar dimensiones
?("Numero de puntos Y = "+num2str(length(y_field)));
?("Numero de puntos Z = "+num2str(length(z_field)));
?("Dimension E2_yz = "+num2str(size(E2_yz)));

# Si E2_yz es [Y,Z], transponer para image(Z,Y,E2_plot)
# La primera dimension de la matriz debe corresponder a Z
E2_plot = transpose(E2_yz);

###########################################################
# TITULO CON LOS PARAMETROS DE LA COMBINACION
###########################################################

Au_W_nm = round(Au_W*1e9);
Ag_W_nm = round(Ag_W*1e9);

Title_Field = "|E|^2 - Au_W="
    + num2str(Au_W_nm)
    + " nm, Ag_W="
    + num2str(Ag_W_nm)
    + " nm";

###########################################################
## REPRESENTACION DEL PLANO Y-Z
###########################################################

image(
    y_field,
    z_field,
    E2_yz,
    "y (um)",
    "z (um)",
    Title_Field
    );

###########################################################
## EXPORTAR IMAGEN
###########################################################

ImageName = "Field_Ge_Inicio_AuW_"
    + num2str(Au_W_nm)
    + "_AgW_"
    + num2str(Ag_W_nm)
    + ".png";

exportfigure(ImageName); 
 
 ############################################################
# Ge_Abs: PLOT P ON CENTRAL XY SLICE
# Monitor: Ge_Abs
############################################################

# Obtener el resultado P del monitor
Pg = getresult("Ge_Abs","P");

# Obtener las coordenadas espaciales
x = Pg.x;
y = Pg.y;
z = Pg.z;

# Seleccionar el plano Z central
Nz = length(z);
iz = ceil(Nz/2);

z_slice = z(iz);

# Extraer Pz en el plano XY central
Pz_slice = pinch(Pg.Pz,3,iz);

# Convertir coordenadas a micrometros
x_um = x*1e6;
y_um = y*1e6;

# Crear titulo
Title_P = "Ge_Abs: P - Au_W="
    + num2str(Au_W_nm)
    + " nm, Ag_W="
    + num2str(Ag_W_nm)
    + " nm";

# Graficar el mapa 2D
image(
    x_um,
    y_um,
    Pz_slice,
    "x (um)",
    "y (um)",
    Title_P
    );
###########################################################
## EXPORTAR IMAGEN
###########################################################

ImageName = "Ge_Abs_P_AuW_"
    + num2str(Au_W_nm)
    + "_AgW_"
    + num2str(Ag_W_nm)
    + ".png";

exportfigure(ImageName); 


###########################################################
## SAVE RESULTS AFTER EACH COMPLETED ITERATION
###########################################################

matlabsave("AuAg_width_sweep_results.mat",
    Au_values,
    Ag_values,
    E2max_Ant,
    E2max_T2,
    E2max_GeAbs);

?("Results saved after iteration i="
    + num2str(i)
    + ", j="
    + num2str(j));

?("Au_W = " + num2str(Au_W*1e9) + " nm");
?("Ag_W = " + num2str(Ag_W*1e9) + " nm");
  
    }
}


        
        
        
